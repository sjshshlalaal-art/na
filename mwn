<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halloween Spesial 🎃</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #6b5b6b;
            font-family: 'Segoe UI', system-ui, sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Overlay kawaii */
        #overlay {
            background: #fff5f7;
            border-radius: 24px;
            padding: 40px 50px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 420px;
            width: 90%;
            animation: popIn 0.5s ease;
        }

        @keyframes popIn {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .overlay-title {
            color: #e91e63;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 30px;
            line-height: 1.4;
        }

        .buttons {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            border: none;
            padding: 14px 28px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-yes {
            background: #ff8fab;
            color: white;
        }

        .btn-yes:hover {
            background: #ff6b8a;
            transform: scale(1.05);
        }

        .btn-no {
            background: #fce4ec;
            color: #ad1457;
        }

        .btn-no:hover {
            background: #f8bbd0;
            transform: scale(1.05);
        }

        /* Scare screen */
        #scare {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            z-index: 9999;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            cursor: none;
        }

        #scare.active {
            display: flex;
        }

        #scare-img {
            max-width: 90vw;
            max-height: 80vh;
            object-fit: contain;
            animation: shake 0.15s infinite;
            filter: contrast(1.2) brightness(1.1);
        }

        @keyframes shake {
            0% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(-8px, 6px) scale(1.02); }
            50% { transform: translate(8px, -6px) scale(1.03); }
            75% { transform: translate(-6px, -8px) scale(1.01); }
            100% { transform: translate(0, 0) scale(1); }
        }

        .scare-text {
            color: #ff0000;
            font-size: clamp(1.5rem, 5vw, 3rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-top: 20px;
            text-shadow: 0 0 20px #ff0000, 0 0 40px #ff0000;
            animation: flash 0.3s infinite;
        }

        @keyframes flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* Glitch effect on image */
        .glitch {
            position: relative;
        }

        .glitch::before,
        .glitch::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: inherit;
            opacity: 0.8;
        }
    </style>
</head>
